{
  "name": "cardapio-online",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "pnpm --filter @cardapio/api dev",
    "dev:web": "pnpm --filter @cardapio/web dev",
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "e2e": "pnpm --filter @cardapio/web e2e",
    "build":"pnpm -r --workspace-concurrency=1 build",
    "format": "pnpm -r --workspace-concurrency=1 format"
  }
}
