# Variáveis da pilha de PRODUÇÃO (docker-compose.prod.yml). Copie para .env.production NA VPS, fora do
# repositório, e preencha. Nunca versione o .env.production. Este arquivo não contém valores reais.
# Gestão de segredos (P-16) ainda não está definida: não coloque estes valores em nenhum outro lugar
# versionado ou compartilhado.

# Tag imutável das imagens, uma por commit (ex.: o resultado de `git rev-parse --short HEAD`).
IMAGE_TAG=

# PostgreSQL próprio do projeto (banco, usuário e senha exclusivos; senha longa e única).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Chave da API. Gere com `node ace generate:key` e guarde só aqui.
APP_KEY=

# Origem pública do site, EXATAMENTE a que o navegador usa (https, sem barra final). A API compara
# o header Origin com este valor (ADR 0002). Domínio canônico: sem "www".
APP_URL=https://menubora.com.br

# Opcionais
# APP_NAME=cardapio-api
# LOG_LEVEL=info
