LOG_LEVEL=silent
DB_DATABASE=cardapio_test
APP_URL=http://localhost:3000
# Os testes fazem muitos logins do mesmo IP; o limite por IP é alto aqui (o teste de 429 o reduz).
LIMITER_LOGIN_IP_PER_MINUTE=10000
LIMITER_LOGIN_IP_EMAIL_PER_MINUTE=5
LIMITER_PASSWORD_PER_MINUTE=1000
# Uploads dos testes ficam em tmp/ (ignorado pelo git)
UPLOADS_ROOT=tmp/test-storage
# Os testes de pedido criam muitos pedidos do mesmo IP; o teste de 429 reduz o limite.
LIMITER_ORDER_PER_MINUTE=10000
# Idem para a cotação do carrinho.
LIMITER_QUOTE_PER_MINUTE=10000
# Idem para o acompanhamento de pedido.
LIMITER_TRACKING_PER_MINUTE=10000
