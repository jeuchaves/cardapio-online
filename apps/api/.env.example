# Copie para .env e ajuste. Nunca versione o .env.

# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
APP_NAME=cardapio-api
LOG_LEVEL=info
# Gere com: node ace generate:key
APP_KEY=
# Origem pública da aplicação (a que o navegador usa, ou seja, o Next.js).
# Em produção, a mesma origem do domínio. Usada na validação de Origin (ADR 0002).
APP_URL=http://localhost:3000

# Banco de dados (PostgreSQL 15+). Devem coincidir com o .env da raiz.
DB_HOST=127.0.0.1
# Deve coincidir com POSTGRES_PORT do .env da raiz.
DB_PORT=5432
DB_USER=cardapio
DB_PASSWORD=troque-esta-senha
DB_DATABASE=cardapio_dev

# Sessão (ADR 0002). Opcionais; os padrões são os valores abaixo.
# SESSION_COOKIE_NAME=cardapio_session
# SESSION_IDLE_TIMEOUT=2h
# SESSION_ABSOLUTE_HOURS=12

# Rate limit por minuto (ADR 0004). Opcionais; os padrões são os valores abaixo.
# LIMITER_LOGIN_IP_EMAIL_PER_MINUTE=5
# LIMITER_LOGIN_IP_PER_MINUTE=20
# LIMITER_PASSWORD_PER_MINUTE=5
# LIMITER_ORDER_PER_MINUTE=5

# Imagens (ADR 0003). Opcionais; os padrões são os valores abaixo.
# Pasta local dos uploads, relativa a apps/api (ignorada pelo git).
# UPLOADS_ROOT=storage
# Base das URLs de imagem devolvidas pela API (o Next repassa /uploads para a API).
# UPLOADS_PUBLIC_BASE=/uploads
