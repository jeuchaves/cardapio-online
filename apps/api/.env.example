# Copie para .env e ajuste. Nunca versione o .env.

# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
APP_NAME=cardapio-api
LOG_LEVEL=info
# Gere com: node ace generate:key
APP_KEY=
# Origem pública da aplicação (a que o navegador usa, ou seja, o Next.js).
# Em produção, a mesma origem do domínio. Usada na validação de Origin (ADR 0002).
APP_URL=http://localhost:3000

# Banco de dados (PostgreSQL 15+). Devem coincidir com o .env da raiz.
DB_HOST=127.0.0.1
# Deve coincidir com POSTGRES_PORT do .env da raiz.
DB_PORT=5432
DB_USER=cardapio
DB_PASSWORD=troque-esta-senha
DB_DATABASE=cardapio_dev
