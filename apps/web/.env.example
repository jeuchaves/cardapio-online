# Copie para .env.local. Nunca versione o .env.local.

# URL interna da API, usada só pelo rewrite de /api no servidor do Next.js.
API_INTERNAL_URL=http://localhost:3333

# URL pública do site, gravada nos QR Codes (<URL>/r/<slug>). Em produção, o domínio real
# (ex.: https://cardapio.exemplo.com.br). Vazia, o painel usa a origem em que está aberto.
# Lida no build: alterar exige novo build.
NEXT_PUBLIC_SITE_URL=
