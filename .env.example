# Variáveis do Docker Compose (PostgreSQL). Copie para .env e ajuste.
# Devem coincidir com DB_USER, DB_PASSWORD e DB_DATABASE de apps/api/.env.
POSTGRES_USER=cardapio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cardapio_dev
# Porta publicada no host (só em 127.0.0.1). Mude se a 5432 já estiver em uso.
# Deve coincidir com DB_PORT de apps/api/.env.
POSTGRES_PORT=5432
